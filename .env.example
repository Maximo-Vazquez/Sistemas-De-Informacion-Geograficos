# Copiá este archivo a .env para desarrollo local. Nunca subas .env al repositorio.
DEBUG=True
DJANGO_SECRET_KEY=cambiar-por-una-clave-local
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL de Django (docker compose up -d db). Para GeoDjango se requiere
# una conexión a PostGIS y las bibliotecas GDAL/GEOS correspondientes.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=visor_sig
DB_USER=visor_sig
DB_PASSWORD=visor_sig
DB_HOST=localhost
DB_PORT=5432

# OAuth de Google (console.cloud.google.com > APIs y servicios > Credenciales).
# URI de redirección autorizada en local: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GeoServer local (docker compose up -d geoserver). Consola: http://localhost:8085/geoserver
GEOSERVER_URL=http://localhost:8085/geoserver
GEOSERVER_WORKSPACE=ign
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_CAPAS_EDITABLES=elementos_relevados

# PostGIS con las capas del IGN (docker compose up -d postgis), puerto 5433 en el host.
POSTGIS_PASSWORD=sig_ign

# Opcional: servir el frontend desde el dev server de Vite (pnpm --dir frontend dev).
VITE_DEV_SERVER_URL=
