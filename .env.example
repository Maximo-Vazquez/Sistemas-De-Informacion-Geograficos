# Copiá este archivo a .env para desarrollo local. Nunca subas .env al repositorio.
DEBUG=True
DJANGO_SECRET_KEY=cambiar-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (docker compose up -d db). Para GeoDjango:
# DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_ENGINE=django.db.backends.postgresql
DB_NAME=visor_sig
DB_USER=visor_sig
DB_PASSWORD=visor_sig
DB_HOST=localhost
DB_PORT=5432

# OAuth de Google (console.cloud.google.com > APIs y servicios > Credenciales).
# URI de redirección autorizada en local: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: servir el frontend desde el dev server de Vite (pnpm --dir frontend dev).
VITE_DEV_SERVER_URL=
